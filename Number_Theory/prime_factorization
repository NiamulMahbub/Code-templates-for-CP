/*
primes vector is collected by running sieve
will make an array called pfac which stores the prime factorization of i in pfac[i]
can do it upto number n
*/

void PF(vector<vll> &pfac, vll &primes, ll n)
{
    for (ll i=2; i<=n; i++)
    {
        ll temp=i;
        
        for (ll j=0; temp!=1 && j<primes.size() && primes[j]*primes[j]<=temp ; j++)
        {
            while (temp%primes[j]==0)
            {
                temp/=primes[j];
                pfac[i].pb(primes[j]);
            }
        }

        if(temp!=1) pfac[i].pb(temp);
    }
}
